{
  "name": "nightshift",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*",
    "spike"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev",
    "e2e": "turbo run build && node apps/daemon/e2e/run.ts",
    "spike": "node spike/run.ts",
    "spike:real": "node --env-file=.env spike/real.ts",
    "demo": "turbo run build && node apps/daemon/e2e/run.ts --demo",
    "serve": "node apps/daemon/dist/cli.js serve",
    "nightshift": "node apps/daemon/dist/cli.js"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "turbo": "2.11.9",
    "typescript": "5.9.3"
  }
}
